# Copy to .env.local and fill in. Nothing here is secret — .env.local is
# gitignored, this template is not.

# Canonical origin, no trailing slash. Drives metadataBase, the sitemap and
# robots.txt (see lib/site.ts). Optional: defaults to the production URL, so
# only set it if you are serving the site from somewhere else.
NEXT_PUBLIC_SITE_URL=https://www.treehouseparkcity.com

# Google Maps Static API key for the location block. Leave empty and the block
# renders a branded placeholder instead, so the build never breaks without it.
# Restrict the key by HTTP referrer in Google Cloud Console — a static map URL
# carries its key in the page HTML. See lib/map.ts.
NEXT_PUBLIC_GOOGLE_MAPS_STATIC_KEY=

# Google Tag Manager container ID. GA4 lives INSIDE this container — do not add
# gtag.js or <GoogleAnalytics /> anywhere in code, or every pageview is counted
# twice. Leave empty and GTM simply does not load; nothing breaks.
NEXT_PUBLIC_GTM_ID=

# TESTING ONLY, for GTM Preview mode. GTM normally loads only on the production
# Vercel deployment, so Preview cannot reach a branch deploy or localhost.
# Setting this to 'true' loads it in any environment. Never commit it as true
# and never set it in Vercel — leave it to .env.local.
# NEXT_PUBLIC_GTM_FORCE_ENABLE=true

# Which deployment this is. Set to exactly "production" in the host's
# production environment ONLY — never on a preview/branch deploy, never
# locally. It is the single switch behind robots.txt, the pages' noindex
# metadata and whether GTM loads, so setting it anywhere else makes a preview
# both crawlable and tracked.
#
# Host-agnostic on purpose: Netlify now, Vercel later. On Vercel, VERCEL_ENV
# is read as a fallback, so this is belt-and-braces there rather than required.
#
# NEXT_PUBLIC_ means it is inlined at build time, not read at runtime —
# changing it requires a redeploy before it takes effect.
NEXT_PUBLIC_SITE_ENV=
