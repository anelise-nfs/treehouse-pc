# Copy to .env.local and fill in. Nothing here is secret — .env.local is
# gitignored, this template is not.

# Canonical origin, no trailing slash. Drives metadataBase, the sitemap and
# robots.txt (see lib/site.ts). Optional: defaults to the production URL, so
# only set it if you are serving the site from somewhere else.
NEXT_PUBLIC_SITE_URL=https://www.treehouseparkcity.com

# Google Maps Static API key for the location block. Leave empty and the block
# renders a branded placeholder instead, so the build never breaks without it.
# Restrict the key by HTTP referrer in Google Cloud Console — a static map URL
# carries its key in the page HTML. See lib/map.ts.
NEXT_PUBLIC_GOOGLE_MAPS_STATIC_KEY=
